# Copy to .env when you want to override defaults. Never commit credentials.
DOWNLOAD_DELAY=3
HTTP_CACHE=false
LOG_LEVEL=INFO
# Stable identity for HTTP requests; Chromium keeps its native User-Agent.
HTTP_USER_AGENT=tcg-scraping/0.1 (+https://github.com/kederiku/tcg-scraping)
# Linux only: use your host UID/GID if they differ from 1000.
USER_UID=1000
USER_GID=1000
